package components

import (
	"fmt"
	"vixel-nexus/internal/models"
)

templ StatCard(label string, value string, trend string, trendUp bool) {
	<div class="glass p-6 rounded-3xl space-y-4 relative overflow-hidden group">
		<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
			<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity text-white"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
		</div>
		<div class="space-y-1">
			<span class="text-xs font-bold text-slate-500 uppercase tracking-widest">{ label }</span>
			<div class="text-3xl font-bold text-white tracking-tight">{ value }</div>
		</div>
		<div class={ "text-sm font-semibold flex items-center gap-1", templ.KV("text-emerald-400", trendUp), templ.KV("text-rose-400", !trendUp) }>
			if trendUp {
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
			} else {
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
			}
			<span>{ trend }</span>
			<span class="text-slate-500 font-normal ml-1">vs last period</span>
		</div>
	</div>
}

templ TransactionTable(transactions []models.Transaction) {
	<div class="glass rounded-3xl overflow-hidden">
		<table class="w-full text-left border-collapse">
			<thead>
				<tr class="border-b border-slate-800 bg-slate-900/50">
					<th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest">Transaction ID</th>
					<th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest">Merchant</th>
					<th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest">Amount</th>
					<th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest">Status</th>
					<th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest">Date</th>
				</tr>
			</thead>
			<tbody id="transaction-body" class="divide-y divide-slate-800/50">
				for _, t := range transactions {
					@TransactionRow(t)
				}
			</tbody>
		</table>
	</div>
}

templ TransactionRow(t models.Transaction) {
	<tr class="hover:bg-slate-900/40 transition-colors group">
		<td class="px-6 py-4">
			<span class="font-mono text-xs text-indigo-400 font-medium">#{ t.ID }</span>
		</td>
		<td class="px-6 py-4 font-semibold text-slate-200">{ t.Merchant }</td>
		<td class="px-6 py-4 font-bold text-white">
			{ fmt.Sprintf("%s %.2f", t.Currency, t.Amount) }
		</td>
		<td class="px-6 py-4">
			<span class={ "px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider", 
				templ.KV("bg-emerald-500/10 text-emerald-500", t.Status == models.StatusCaptured),
				templ.KV("bg-amber-500/10 text-amber-500", t.Status == models.StatusPending),
				templ.KV("bg-rose-500/10 text-rose-500", t.Status == models.StatusFailed),
				templ.KV("bg-slate-500/10 text-slate-400", t.Status == models.StatusRefunded) }>
				{ string(t.Status) }
			</span>
		</td>
		<td class="px-6 py-4 text-sm text-slate-500">
			{ t.CreatedAt.Format("Jan 02, 15:04:05") }
		</td>
	</tr>
}
